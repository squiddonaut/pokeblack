    "messages": [
        {
            "id": "a003_426_0000",
            "en_US": [
                "I'm the Day-Care Man.{VAR BE01}\n",
                "We take care of the precious Pokémon\n",
                "of other Trainers.{VAR BE01}\n",
                "If you'd like us to raise your\n",
                "Pokémon, have a word with my wife."
            ]
        },
        {
            "id": "a003_426_0001",
            "en_US": [
                "Glad you came!\n",
                "Your {VAR 0102 0000}'s doing just fine."
            ]
        },
        {
            "id": "a003_426_0002",
            "en_US": [
                "Glad you came!{VAR BE01}\n",
                "Your {VAR 0102 0000} and\n",
                "{VAR 0102 0001} are doing just fine.{VAR BE01}\n",
                "The two seem to get along very well!"
            ]
        },
        {
            "id": "a003_426_0003",
            "en_US": [
                "Glad you came!{VAR BE01}\n",
                "Your {VAR 0102 0000} and\n",
                "{VAR 0102 0001} are doing just fine.{VAR BE01}\n",
                "The two seem to get along."
            ]
        },
        {
            "id": "a003_426_0004",
            "en_US": [
                "Glad you came!{VAR BE01}\n",
                "Your {VAR 0102 0000} and\n",
                "{VAR 0102 0001} are doing just fine.{VAR BE01}\n",
                "The two don't really seem to like\n",
                "each other much."
            ]
        },
        {
            "id": "a003_426_0005",
            "en_US": [
                "Glad you came!{VAR BE01}\n",
                "Your {VAR 0102 0000} and\n",
                "{VAR 0102 0001} are doing just fine.{VAR BE01}\n",
                "The two prefer to play with other\n",
                "Pokémon more than with each other."
            ]
        },
        {
            "id": "a003_426_0006",
            "en_US": [
                "Ah, it's you!{VAR BE01}\n",
                "We were raising your Pokémon,\n",
                "and my goodness, were we surprised!{VAR BE01}\n",
                "Your Pokémon was holding an Egg!{VAR BE01}\n",
                "We don't know how it got there,\n",
                "but your Pokémon had it.{VAR BE01}\n",
                "You do want it, don't you?"
            ]
        },
        {
            "id": "a003_426_0007",
            "en_US": [
                "{VAR 0100 0000} received the Egg from\n",
                "the Day-Care Man."
            ]
        },
        {
            "id": "a003_426_0008",
            "en_US": "You take good care of it."
        },
        {
            "id": "a003_426_0009",
            "en_US": [
                "You have no room for it right now...\n",
                "Come back when you've made room."
            ]
        },
        {
            "id": "a003_426_0010",
            "en_US": [
                "I really will keep it.\n",
                "You do want this Egg, yes?"
            ]
        },
        {
            "id": "a003_426_0011",
            "en_US": [
                "Well then, I'll hang on to it.\n",
                "Thanks!"
            ]
        },
        {
            "id": "a003_426_0012",
            "en_US": [
                "I'm the Day-Care Lady.\n",
                "We can raise Pokémon for you.{VAR BE01}\n",
                "Would you like us to raise\n",
                "your Pokémon?"
            ]
        },
        {
            "id": "a003_426_0013",
            "en_US": [
                "I'm the Day-Care Lady.{VAR BE01}\n",
                "We can raise Pokémon for you.\n",
                "What do you want to do today?"
            ]
        },
        {
            "id": "a003_426_0014",
            "en_US": [
                "Very good.\n",
                "Come again."
            ]
        },
        {
            "id": "a003_426_0015",
            "en_US": [
                "Ah, there you are!\n",
                "My husband was looking for you."
            ]
        },
        {
            "id": "a003_426_0016",
            "en_US": [
                "You can't leave your only Pokémon\n",
                "with me! How would you battle?{VAR BE01}\n",
                "Come back another time."
            ]
        },
        {
            "id": "a003_426_0017",
            "en_US": [
                "Which Pokémon should we raise\n",
                "for you?{VAR BE01}"
            ]
        },
        {
            "id": "a003_426_0018",
            "en_US": [
                "Now, now.\n",
                "That is merely an Egg!"
            ]
        },
        {
            "id": "a003_426_0019",
            "en_US": [
                "Fine, we'll raise your {VAR 0102 0000}\n",
                "for a while.{VAR BE01}"
            ]
        },
        {
            "id": "a003_426_0020",
            "en_US": "Come back for it later."
        },
        {
            "id": "a003_426_0021",
            "en_US": [
                "We can raise two of your Pokémon.\n",
                "Would you like us to raise another?"
            ]
        },
        {
            "id": "a003_426_0022",
            "en_US": [
                "You have energetic Pokémon.\n",
                "Do you want your Pokémon back?"
            ]
        },
        {
            "id": "a003_426_0023",
            "en_US": [
                "By level, your {VAR 0101 0000} has\n",
                "grown by about {VAR 0201 0001}.{VAR BE01}"
            ]
        },
        {
            "id": "a003_426_0024",
            "en_US": [
                "If you want your {VAR 0101 0000} back,\n",
                "it will cost ${VAR 0204 0001}.{VAR BE00}\n",
                "Do you want it back?"
            ]
        },
        {
            "id": "a003_426_0025",
            "en_US": "You don't have enough money..."
        },
        {
            "id": "a003_426_0026",
            "en_US": [
                "{VAR 0100 0001} took {VAR 0101 0000} back\n",
                "from the Day-Care Lady.{VAR BE01}"
            ]
        },
        {
            "id": "a003_426_0027",
            "en_US": [
                "Do you want to take back the other\n",
                "one, too? "
            ]
        },
        {
            "id": "a003_426_0028",
            "en_US": [
                "Huh? Now, now.{VAR BE01}\n",
                "If you leave that Pokémon with\n",
                "me, you'll be left with just one.{VAR BE01}\n",
                "You will be better off if you catch\n",
                "some more, if I do say so myself."
            ]
        },
