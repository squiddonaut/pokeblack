        },
        {
            "id": "a003_461_0021",
            "en_US": "Would you like to challenge right away?"
        },
        {
            "id": "a003_461_0022",
            "en_US": [
                "OK. See you later.\n",
                "I've been waiting for you!"
            ]
        },
        {
            "id": "a003_461_0023",
            "en_US": [
                "You will take a Battle Test using\n",
                "three Pokémon for Single Battles{VAR BE00}\n",
                "and four Pokémon for Double Battles.{VAR BE01}\n",
                "You may not use duplicate Pokémon or\n",
                "held items.{VAR BE01}\n",
                "For these battles, all Pokémon will be\n",
                "set to Lv. 50.{VAR BE01}\n",
                "You will battle against five Trainers in a\n",
                "row, and I will be your judge.{VAR BE01}\n",
                "What would you like to do?"
            ]
        },
