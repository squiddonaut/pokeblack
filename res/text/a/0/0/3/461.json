        {
            "id": "a003_461_0000",
            "en_US": [
                "I will judge your battles in a\n",
                "Battle Test!{VAR BE01}\n",
                "What would you like to do?"
            ]
        },
        {
            "id": "a003_461_0001",
            "en_US": [
                "The master returns! Would you like to\n",
                "challenge a Battle Test?"
            ]
        },
        {
            "id": "a003_461_0002",
            "en_US": [
                "I am sorry...{VAR BE01}\n",
                "It may be too early for you to challenge\n",
                "a Battle Test.{VAR BE01}\n",
                "Please come back after you finish\n",
                "your journey and build your strength."
            ]
        },
        {
            "id": "a003_461_0003",
            "en_US": "See you again."
        },
        {
            "id": "a003_461_0004",
            "en_US": [
                "Which challenge would you like,\n",
                "Single or Double?"
            ]
        },
        {
            "id": "a003_461_0005",
            "en_US": [
                "Then, let's begin.{VAR BE01}\n",
                "Please bear in mind that once you start\n",
                "the challenge, you will face five battles{VAR BE00}\n",
                "without a break.{VAR BE01}\n",
                "Now, please choose the Pokémon you would\n",
                "like to battle with.{VAR BE01}"
            ]
        },
        {
            "id": "a003_461_0006",
            "en_US": [
                "Saving...\n",
                "Don't turn off the power."
            ]
        },
        {
            "id": "a003_461_0007",
            "en_US": [
                "Now, the Battle Test begins!\n",
                "Please go inside!{VAR BE01}"
            ]
        },
        {
            "id": "a003_461_0008",
            "en_US": [
                "All right.{VAR BE01}\n",
                "I will tell you the result of your\n",
                "Battle Test.{VAR BE01}\n",
                "The test result is...{VAR BE01}"
            ]
        },
        {
            "id": "a003_461_0009",
            "en_US": [
                "Master Rank! Wonderful!\n",
                "Please let me be your apprentice."
            ]
        },
        {
            "id": "a003_461_0010",
            "en_US": [
                "The result is Elite Rank!\n",
                "That's something you can brag about!"
            ]
        },
        {
            "id": "a003_461_0011",
            "en_US": [
                "The result is Hyper Rank!\n",
                "You must be doing a lot of practice."
            ]
        },
        {
            "id": "a003_461_0012",
            "en_US": [
                "The result is Super Rank.\n",
                "You are quite strong."
            ]
        },
        {
            "id": "a003_461_0013",
            "en_US": [
                "The result is Normal Rank.\n",
                "Your strength is average."
            ]
        },
        {
            "id": "a003_461_0014",
            "en_US": [
                "The result is Novice Rank.\n",
                "You could try a little bit harder."
            ]
        },
        {
            "id": "a003_461_0015",
            "en_US": [
                "The result is Beginner Rank.\n",
                "Maybe you should learn the basics first."
            ]
        },
        {
            "id": "a003_461_0016",
            "en_US": [
                "I've been waiting for you!{VAR BE01}\n",
                "Would you like to challenge\n",
                "the downloaded Single Battle Test?"
            ]
        },
        {
            "id": "a003_461_0017",
            "en_US": [
                "Would you like to download\n",
                "a special Battle Test?"
            ]
        },
        {
            "id": "a003_461_0018",
            "en_US": [
                "Hmm... I don't see anything\n",
                "to download...{VAR BE01}\n",
                "What would you like to do?"
            ]
        },
        {
            "id": "a003_461_0019",
            "en_US": [
                "I downloaded a special\n",
                "Single Battle Test!{VAR BE01}\n",
                "You only have one chance to challenge,\n",
                "so please battle until the end{VAR BE00}\n",
                "without turning off the power.{VAR BE01}"
            ]
        },
        {
            "id": "a003_461_0020",
            "en_US": [
                "I downloaded a special \n",
                "Double Battle Test!{VAR BE01}\n",
                "You only have one chance to challenge,\n",
                "so please battle until the end{VAR BE00}\n",
                "without turning off the power.{VAR BE01}"
