    "flags": 224,
    "messages": [
        {
            "id": "a003_347_0000",
            "en_US": [
                "Er...\n",
                "Who was I again?{VAR BE01}\n",
                "...\n",
                "...{VAR BE01}\n",
                "...Oh, that's right!\n",
                "I am the Move Deleter!{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0001",
            "en_US": [
                "You've come to make me force your\n",
                "Pokémon to forget some moves?"
            ]
        },
        {
            "id": "a003_347_0002",
            "en_US": "Which Pokémon should forget a move?{VAR BE01}"
        },
        {
            "id": "a003_347_0003",
            "en_US": [
                "Remember me if there are moves that\n",
                "need to be forgotten."
            ]
        },
        {
            "id": "a003_347_0004",
            "en_US": [
                "That Pokémon knows only one move,\n",
                "so it can't be forgotten...{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0005",
            "en_US": [
                "What? That's an Egg.\n",
                "No Egg should know any moves.{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0006",
            "en_US": [
                "OK, then.\n",
                "Which move should be forgotten?{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0007",
            "en_US": [
                "Hm! The move {VAR 0107 0000}?\n",
                "Should that move be forgotten?"
            ]
        },
        {
            "id": "a003_347_0008",
            "en_US": [
                "It worked perfectly!{VAR BE01}\n",
                "Your Pokémon has forgotten the move\n",
                "{VAR 0107 0000} completely."
            ]
        },
