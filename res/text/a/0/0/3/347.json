        {
            "id": "a003_347_0020",
            "en_US": [
                "Which move should\n",
                "{VAR 0102 0000} remember?{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0021",
            "en_US": [
                "Should the move {VAR 0107 0001}\n",
                "be remembered?"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0022",
            "en_US": [
                "Give up trying to make \n",
                "{VAR 0102 0000} remember a move?"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0023",
            "en_US": [
                "{VAR 0102 0000} remembered the move\n",
                "{VAR 0107 0001} it had forgotten!{VAR BE01}"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0024",
            "en_US": [
                "{VAR 0102 0000} wants to remember\n",
                "the move {VAR 0107 0001}.{VAR BE01}\n",
                "But {VAR 0102 0000} can't learn more\n",
                "than four moves.{VAR BE01}\n",
                "Delete an existing move to make \n",
                "room for {VAR 0107 0001}?"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0025",
            "en_US": [
                "1, {VAR BE02 0014}2, and{VAR BE02 0014}... {VAR BE02 0014}... {VAR BE02 0014}... Ta-da!{VAR BE05 0003}{VAR BE05 0005}{VAR BE01}\n",
                "{VAR BE01}\n",
                "{VAR 0102 0000} forgot how to\n",
                "use {VAR 0107 0001}.{VAR BE01}\n",
                "And...{VAR BE01}"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0026",
            "en_US": [
                "{VAR 0102 0000} remembered the move\n",
                "{VAR 0107 0001} it had forgotten!{VAR BE01}"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0027",
            "en_US": [
                "Give up on making the Pokémon\n",
                "remember {VAR 0107 0001}?"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0028",
            "en_US": [
                "{VAR 0102 0000} did not remember the\n",
                "move {VAR 0107 0001}.{VAR BE01}"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0029",
            "en_US": [
                "{VAR 0100 0000} handed over one\n",
                "Heart Scale in exchange."
            ]
        },
        {
            "id": "a003_347_0030",
            "en_US": [
                "Is it OK to forget the\n",
                "move {VAR 0107 0000}?"
            ],
            "flags": 205
        },
        {
            "id": "a003_347_0031",
            "en_US": [
                "Everybody calls me the reminder girl.{VAR BE01}\n",
                "I know every move that Pokémon learn\n",
                "while they're leveling up.{VAR BE01}\n",
                "And I can make Pokémon remember\n",
                "those moves!{VAR BE01}\n",
                "If you bring me a Heart Scale, I'll make\n",
                "a Pokémon remember a move.{VAR BE01}"
            ]
        },
        {
            "id": "a003_347_0032",
            "en_US": "Should a move be remembered?"
        },
        {
            "id": "a003_347_0033",
            "en_US": "Which Pokémon should learn it?{VAR BE01}"
        },
        {
            "id": "a003_347_0034",
            "en_US": [
                "If any of your Pokémon needs to\n",
                "remember a move, bring me a Heart Scale!"
            ]
        },
        {
            "id": "a003_347_0035",
            "en_US": "Eggs can't remember moves!"
        },
        {
            "id": "a003_347_0036",
            "en_US": [
                "This Pokémon hasn't forgotten\n",
                "any moves."
            ]
        },
