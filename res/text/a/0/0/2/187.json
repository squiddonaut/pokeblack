            "id": "a002_187_0061",
            "en_US": [
                "Striaton City Gym Leaders\n",
                "Chili, Cress, Cilan"
            ]
        },
        {
            "id": "a002_187_0062",
            "en_US": "Triple Trouble!"
        },
        {
            "id": "a002_187_0063",
            "en_US": [
                "The fundamentals of Pokémon battling\n",
                "are type matchups! They're important!"
            ]
        },
        {
            "id": "a002_187_0064",
            "en_US": [
                "Nacrene City Gym Leader\n",
                "Lenora"
            ]
        },
        {
            "id": "a002_187_0065",
            "en_US": "An Archeologist with Backbone"
        },
        {
            "id": "a002_187_0066",
            "en_US": [
                "Curiosity is the spice of life!\n",
                "Without it, life is bland!"
            ]
        },
        {
            "id": "a002_187_0067",
            "en_US": [
                "Castelia City Gym Leader\n",
                "Burgh"
            ]
        },
        {
            "id": "a002_187_0068",
            "en_US": "Premier Insect Artist"
        },
        {
            "id": "a002_187_0069",
            "en_US": [
                "Umm... That's right. You!\n",
                "Use Bug-type Pokémon!"
            ]
        },
        {
            "id": "a002_187_0070",
            "en_US": [
                "Nimbasa City Gym Leader\n",
                "Elesa"
            ]
        },
        {
            "id": "a002_187_0071",
            "en_US": "The Shining Beauty"
        },
        {
            "id": "a002_187_0072",
            "en_US": [
                "May you always continue to be a person\n",
                "who brightens your surroundings."
            ]
        },
        {
            "id": "a002_187_0073",
            "en_US": [
                "Driftveil City Gym Leader\n",
                "Clay"
            ]
        },
        {
            "id": "a002_187_0074",
            "en_US": "The Underground Boss"
        },
        {
            "id": "a002_187_0075",
            "en_US": [
                "Ya always want to live honestly\n",
                "fer yerself and yer Pokémon."
            ]
        },
        {
            "id": "a002_187_0076",
            "en_US": [
